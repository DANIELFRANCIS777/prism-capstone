# "production" enables deployment safety checks - notably, the gateway will
# refuse to start if ADMIN_BOOTSTRAP_PASSWORD is still the default below.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
UPSTREAM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Applies pending Alembic revisions on startup, serialized across replicas by a
# Postgres advisory lock. Set to false if you run `alembic upgrade head` as an
# explicit release step instead (Fly release_command, a k8s Job, ...).
RUN_MIGRATIONS_ON_STARTUP=true

# Auth signing keys and BYOK credential encryption.
#
# LOCAL DEV: leave all of these unset. Keys are generated into keys/ on first
# startup and kept across restarts by a Docker volume.
#
# PRODUCTION: set the three *_KEY variables below instead, and do NOT rely on
# the generated files - managed hosts have ephemeral disks, so a regenerated
# key logs everyone out and makes every stored BYOK credential permanently
# undecryptable. `python -m app.keygen` prints all three. The gateway refuses
# to start with ENVIRONMENT=production unless they are set.
#
# CREDENTIAL_ENCRYPTION_KEY=
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
#
# Paths are only consulted when the variables above are unset.
# JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap admin account - seeded once if admin_users is empty. Change the
# password in any non-throwaway environment.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=prism-admin-dev-password

# Origins allowed to call the API from a browser (the ops console).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# Brute-force protection on the unauthenticated auth endpoints. The per-minute
# ceiling caps request volume per IP (and per email on login); the lockout
# stops slower guessing that stays under that ceiling. A successful login
# clears an account's failure streak.
AUTH_MAX_ATTEMPTS_PER_MINUTE=10
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Periodic in-process pruning of tables that otherwise grow forever (stale
# rate-limit windows, expired refresh tokens). Serialized across replicas by a
# Postgres advisory lock, so it's safe to leave on with several instances.
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=3600
RATE_LIMIT_WINDOW_RETENTION_SECONDS=600
