{
  "info": {
    "name": "Prism Gateway",
    "description": "Every endpoint the gateway exposes. Import into Postman, then just run requests - the collection variables already point at the local Docker stack and the seeded demo keys. Run 'Admin Auth > Login' first if you want to hit any /admin/* route, or 'Self-serve auth > Signup'/'Login' for /me/* routes - both automatically save their access/refresh tokens into collection variables the rest of their folder already references. 'Self-serve (Me) > Create key' likewise saves the raw issued key into {{my_key}}, ready for the 'Real providers (BYOK)' folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "prism-admin-dev-password" },
    { "key": "admin_access_token", "value": "" },
    { "key": "admin_refresh_token", "value": "" },
    { "key": "search_key", "value": "prism-sk-search-1a2b3c" },
    { "key": "research_key", "value": "prism-sk-research-4d5e6f" },
    { "key": "free_key", "value": "prism-sk-free-7g8h9i" },
    { "key": "budget_demo_key", "value": "prism-sk-budget-demo-0j1k2l" },
    { "key": "search_key_id", "value": "", "description": "Numeric virtual_keys.id for the search tenant - look it up via GET /admin/keys (keys are now referenced by id, not the raw secret)." },
    { "key": "user_email", "value": "postman-tester@example.com", "description": "Change this (or the Signup request will 409 on re-run once the account exists - use Login instead after the first run)." },
    { "key": "user_password", "value": "postman-test-password", "description": "8+ chars." },
    { "key": "user_access_token", "value": "" },
    { "key": "user_refresh_token", "value": "" },
    { "key": "my_key", "value": "", "description": "Raw self-serve gateway key (prism-sk-...) - auto-filled by 'Self-serve (Me) > Create key'. Shown once by the API; this is where Postman remembers it for you." },
    { "key": "groq_api_key", "value": "", "description": "Paste your own free key from console.groq.com/keys before running 'Add BYOK credential - groq'. Never commit a real value here." },
    { "key": "gemini_api_key", "value": "", "description": "Paste your own free key from aistudio.google.com/apikey before running 'Add BYOK credential - gemini'. Never commit a real value here." }
  ],
  "item": [
    {
      "name": "Data plane",
      "item": [
        {
          "name": "Chat completion - fast (non-streaming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{search_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"fast\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"What is a message queue?\"}]\n}"
            }
          }
        },
        {
          "name": "Chat completion - fast (streaming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{search_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"fast\",\n  \"stream\": true,\n  \"messages\": [{\"role\": \"user\", \"content\": \"Explain server-sent events briefly.\"}]\n}"
            },
            "description": "Postman shows SSE as one raw response body once the stream ends (older Postman versions don't render it token-by-token) - use curl -N if you want to watch it arrive live: see AGENTS.md."
          }
        },
        {
          "name": "Chat completion - auto (short-but-hard, should route smart)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{research_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"auto\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Prove that the square root of 2 is irrational.\"}]\n}"
            }
          }
        },
        {
          "name": "Chat completion - auto (long-but-trivial, should route fast)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{research_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"auto\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Here is our on-call roster: Monday - Priya, Tuesday - Chen. Who is on call this Thursday?\"}]\n}"
            }
          }
        },
        {
          "name": "Chat completion - smart (research key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{research_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"smart\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"Design a rate limiter for a multi-tenant API. What algorithm would you pick and why?\"}]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Model discovery",
      "description": "GET /v1/models - the standard OpenAI-compatible discovery endpoint, served from Prism's own registered catalog (not a live call out to the provider). Scoped to the calling key's allowlist, which is what makes a separate model-vs-provider validation step unnecessary.",
      "item": [
        {
          "name": "List models - seeded search key (allowlist is [fast] only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{search_key}}" }],
            "url": { "raw": "{{base_url}}/v1/models", "host": ["{{base_url}}"], "path": ["v1", "models"] }
          }
        },
        {
          "name": "List models - self-serve key (full catalog)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{my_key}}" }],
            "url": { "raw": "{{base_url}}/v1/models", "host": ["{{base_url}}"], "path": ["v1", "models"] }
          },
          "description": "Includes both Groq models and both Gemini models. Aliases report owned_by 'prism' (they can fail over between providers); literal model names report their real provider."
        },
        {
          "name": "List models - no key (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/models", "host": ["{{base_url}}"], "path": ["v1", "models"] }
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "401 - invalid key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer not-a-real-key" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"fast\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}" }
          }
        },
        {
          "name": "403 - model not on allowlist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{search_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"smart\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}" },
            "description": "search key's allowlist is only [\"fast\"]"
          }
        },
        {
          "name": "404 - unknown model",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{search_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"no-such-model\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}" }
          }
        },
        {
          "name": "402 - budget exhausted (run twice)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{budget_demo_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"fast\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}" },
            "description": "budget-demo key has a $0.00001 budget - the first call consumes it, the second returns 402 budget_exceeded."
          }
        },
        {
          "name": "429 - rate limit (run 11+ times fast)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{free_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/v1/chat/completions", "host": ["{{base_url}}"], "path": ["v1", "chat", "completions"] },
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"fast\",\n  \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]\n}" },
            "description": "free-tier key allows 10 requests/minute - use Postman's Runner to fire this 11+ times quickly."
          }
        }
      ]
    },
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('admin_access_token', body.access_token);",
                  "pm.collectionVariables.set('admin_refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/auth/login", "host": ["{{base_url}}"], "path": ["admin", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            }
          },
          "description": "Run this first. Saves access_token/refresh_token into collection variables that every request in the 'Admin' folder already uses - no copy-pasting needed."
        },
        {
          "name": "Refresh (rotates the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('admin_access_token', body.access_token);",
                  "  pm.collectionVariables.set('admin_refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/auth/refresh", "host": ["{{base_url}}"], "path": ["admin", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{admin_refresh_token}}\"\n}"
            }
          },
          "description": "Consumes the current refresh token and issues a new pair. Running this twice in a row with the same saved token will fail on the second call by design - that's the single-use rotation working."
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/admin/auth/logout", "host": ["{{base_url}}"], "path": ["admin", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{admin_refresh_token}}\"\n}"
            }
          },
          "description": "Revokes the refresh token - it can no longer be used to mint new access tokens. The current access token stays valid until it naturally expires (up to 30 min)."
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Health (liveness)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "description": "Is the process up. Deliberately checks nothing else - a dependency outage shouldn't get the container killed and restarted."
        },
        {
          "name": "Ready (readiness - checks Postgres)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/ready", "host": ["{{base_url}}"], "path": ["ready"] }
          },
          "description": "Can this replica actually serve a request. Returns 503 if Postgres is unreachable - point load balancer readiness probes here, not at /health."
        },
        {
          "name": "List keys (every tenant - operator-provisioned and self-serve)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": { "raw": "{{base_url}}/admin/keys", "host": ["{{base_url}}"], "path": ["admin", "keys"] }
          },
          "description": "Find a key's numeric id here to fill search_key_id - self-serve keys show their org_id, seeded/operator keys show org_id: null."
        },
        {
          "name": "Usage summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/usage?key_id={{search_key_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "usage"],
              "query": [
                { "key": "key_id", "value": "{{search_key_id}}" },
                { "key": "from", "value": "2026-07-01", "disabled": true },
                { "key": "to", "value": "2026-07-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Recent request logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/logs?limit=20",
              "host": ["{{base_url}}"],
              "path": ["admin", "logs"],
              "query": [
                { "key": "key_id", "value": "{{search_key_id}}", "disabled": true },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Cache stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/admin/cache/stats",
              "host": ["{{base_url}}"],
              "path": ["admin", "cache", "stats"],
              "query": [{ "key": "key_id", "value": "{{search_key_id}}", "disabled": true }]
            }
          }
        }
      ]
    },
    {
      "name": "Self-serve auth",
      "description": "The tenant equivalent of 'Admin Auth' - a distinct subject space (email/password, not username/password) with its own access+refresh tokens that are never accepted by /admin/* routes, or vice versa.",
      "item": [
        {
          "name": "Auth config (no auth needed)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/config", "host": ["{{base_url}}"], "path": ["auth", "config"] }
          },
          "description": "Whether signup is open, and the ceilings a self-serve key is capped at (requests_per_minute, monthly_budget_usd, max keys per org)."
        },
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('user_access_token', body.access_token);",
                  "  pm.collectionVariables.set('user_refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/signup", "host": ["{{base_url}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"org_name\": \"Postman Test Org\"\n}"
            }
          },
          "description": "409s if user_email is already registered - change the user_email variable, or just use Login below instead."
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('user_access_token', body.access_token);",
                  "  pm.collectionVariables.set('user_refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            }
          },
          "description": "Run this after Signup has run once (or after logging out) - the mode toggle bug from 2026-08-19 is a frontend-only issue, this always logs in correctly if the email/password are right."
        },
        {
          "name": "Refresh (rotates the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "  pm.collectionVariables.set('user_access_token', body.access_token);",
                  "  pm.collectionVariables.set('user_refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{user_refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{user_refresh_token}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Self-serve (Me)",
      "description": "Everything scoped to the logged-in tenant - no key/key_id param anywhere, identity comes from user_access_token. Run 'Self-serve auth > Signup' or 'Login' first.",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_access_token}}" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "Create key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('my_key', pm.response.json().virtual_key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/me/keys", "host": ["{{base_url}}"], "path": ["me", "keys"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"postman\",\n  \"requests_per_minute\": 20,\n  \"monthly_budget_usd\": 5\n}"
            }
          },
          "description": "Fails with 422 if you already have an active key (capped at 1 by default) - disable it first (below), or reuse the my_key you already have."
        },
        {
          "name": "List keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_access_token}}" }],
            "url": { "raw": "{{base_url}}/me/keys", "host": ["{{base_url}}"], "path": ["me", "keys"] }
          }
        },
        {
          "name": "Disable a key",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/me/keys/:id", "host": ["{{base_url}}"], "path": ["me", "keys", ":id"], "variable": [{ "key": "id", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"disabled\"\n}" }
          },
          "description": "Fill the :id path variable with a key id from 'List keys'. Disabling frees your slot to create a replacement (fixed 2026-08-20 - it used to count disabled keys against the cap too)."
        },
        {
          "name": "List BYOK credentials",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_access_token}}" }],
            "url": { "raw": "{{base_url}}/me/credentials", "host": ["{{base_url}}"], "path": ["me", "credentials"] }
          }
        },
        {
          "name": "Add BYOK credential - groq",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/me/credentials/groq", "host": ["{{base_url}}"], "path": ["me", "credentials", "groq"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"{{groq_api_key}}\",\n  \"label\": \"postman\"\n}"
            }
          },
          "description": "Set the groq_api_key collection variable to your real key from console.groq.com/keys first. The response never echoes the plaintext back - only a masked prefix."
        },
        {
          "name": "Add BYOK credential - gemini",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_access_token}}" },
