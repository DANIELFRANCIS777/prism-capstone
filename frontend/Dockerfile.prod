# Production console image: build the static bundle, then serve it with
# nginx. The dev-server Dockerfile alongside this one is for local work only -
# Vite's own docs warn against exposing that server to untrusted networks,
# and it ships an unminified bundle plus a websocket HMR channel.

FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
# Vite inlines VITE_* at build time, so the API URL is baked into the bundle
# here rather than read at runtime - it has to be passed as a build arg.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build


FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine already runs workers as the unprivileged `nginx` user; the
# master needs root only to bind :80, which is fine inside the container.
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
